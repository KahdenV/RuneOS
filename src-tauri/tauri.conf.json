{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "RUNE OS",
    "version":  "0.13.1",
    "identifier":  "com.kahden.runeos",
    "build":  {
                  "frontendDist":  "frontend-embed"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [

                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; base-uri \u0027none\u0027; object-src \u0027none\u0027; frame-src http://127.0.0.1:*; frame-ancestors \u0027none\u0027; form-action \u0027none\u0027; script-src \u0027self\u0027 http://127.0.0.1:*; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; font-src \u0027self\u0027 data:; img-src \u0027self\u0027 data: blob: http://127.0.0.1:*; media-src \u0027self\u0027 data: blob: http://127.0.0.1:*; connect-src \u0027self\u0027 http://127.0.0.1:* https://openrouter.ai https://api.openai.com https://chatgpt.com https://auth.openai.com https://accounts.spotify.com https://api.spotify.com; worker-src \u0027self\u0027 blob:"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "publisher":  "Kahden Vienna",
                   "targets":  [
                                   "nsis"
                               ],
                   "createUpdaterArtifacts":  false,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "externalBin":  [
                                       "binaries/node"
                                   ],
                   "windows":  {
                                   "nsis":  {
                                                "installerIcon":  "icons/icon.ico",
                                                "headerImage":  "installer/header.bmp",
                                                "sidebarImage":  "installer/sidebar.bmp",
                                                "installerHooks":  "installer/hooks.nsh"
                                            }
                               },
                   "macOS":  {
                                 "minimumSystemVersion":  "10.15",
                                 "hardenedRuntime":  true,
                                 "entitlements":  "entitlements.plist",
                                 "dmg":  {
                                             "background":  "installer/dmg-background.png",
                                             "windowSize":  {
                                                                "width":  660,
                                                                "height":  400
                                                            },
                                             "appPosition":  {
                                                                 "x":  180,
                                                                 "y":  170
                                                             },
                                             "applicationFolderPosition":  {
                                                                               "x":  480,
                                                                               "y":  170
                                                                           }
                                         }
                             },
                   "resources":  {
                                     "../sidecar":  "sidecar",
                                     "frontend-dist":  "frontend",
                                     "../shared":  "shared",
                                     "voice-deps/node_modules":  "node_modules"
                                 }
               },
    "plugins":  {

                }
}
